# scripts/container.ps1 (or scripts/docker.ps1) generates deploy/.env with random credentials.
# Override runtime detection: EOIP_CONTAINER_RUNTIME=podman (or docker, nerdctl, finch)
# FT-AUTH: there is no default account. The first administrator is provisioned from
# these two values when the API starts ('eoip-admin from-env'); the password is hashed
# with argon2id. Sign in to the web UI with this username and password.
EOIP_ADMIN_USERNAME=choose-an-admin-username
EOIP_ADMIN_PASSWORD=replace-with-a-long-random-password
# Service token used by the MCP facade. It is mapped to principal EOIP_API_TOKEN_PRINCIPAL
# with exactly EOIP_API_TOKEN_ROLES; without roles it grants nothing.
EOIP_API_TOKEN=replace-with-at-least-32-random-characters
EOIP_API_TOKEN_ROLES=analyst
EOIP_API_TOKEN_PRINCIPAL=svc-mcp
# Session-signing secret (>= 32 chars). Optional for one replica (a key is generated
# under /data/state), required for several replicas.
EOIP_SESSION_SECRET=
# At most 48 characters (Hubble VARCHAR(48)); container.ps1/.sh generate 48 hex chars.
HUGEGRAPH_PASSWORD=replace-with-a-random-password-max-48-chars
EOIP_LOAD_DEMO=true
# Optional source connector settings. Configure credentials locally; do not commit them.
# EOIP_CONFLUENCE_URL=https://confluence.example
# EOIP_CONFLUENCE_TOKEN=
# EOIP_CONFLUENCE_USERNAME=
# EOIP_CONFLUENCE_PASSWORD=
# EOIP_SERVICENOW_URL=https://instance.service-now.example
# EOIP_SERVICENOW_TOKEN=
# EOIP_SERVICENOW_USERNAME=
# EOIP_SERVICENOW_PASSWORD=
EOIP_WEB_PORT=8080
EOIP_API_PORT=8000
EOIP_MCP_PORT=8001
EOIP_HUBBLE_PORT=8088
# Optional, after staging a model into the model-data volume:
EOIP_OLLAMA_MODEL=
