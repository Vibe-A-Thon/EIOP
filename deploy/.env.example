# scripts/docker.ps1 generates deploy/.env with random credentials.
EOIP_API_TOKEN=replace-with-at-least-24-random-characters
HUGEGRAPH_PASSWORD=replace-with-a-long-random-password
EOIP_LOAD_DEMO=true
EOIP_WEB_PORT=8080
EOIP_API_PORT=8000
EOIP_MCP_PORT=8001
# Optional, after staging a model into the model-data volume:
EOIP_OLLAMA_MODEL=
