{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:eoip:schema:crawl_scope:1.0",
  "title": "CrawlScope v1",
  "type": "object",
  "required": ["start_urls", "allowed_hosts", "include_paths", "exclude_paths", "max_depth", "page_limit", "mime_types", "max_page_bytes"],
  "properties": {
    "start_urls": {"type": "array", "minItems": 1, "maxItems": 100, "items": {"type": "string", "format": "uri"}},
    "allowed_hosts": {"type": "array", "minItems": 1, "maxItems": 100, "items": {"type": "string"}},
    "include_paths": {"type": "array", "maxItems": 100, "items": {"type": "string"}},
    "exclude_paths": {"type": "array", "maxItems": 100, "items": {"type": "string"}},
    "max_depth": {"type": "integer", "minimum": 0, "maximum": 10},
    "page_limit": {"type": "integer", "minimum": 1, "maximum": 10000},
    "mime_types": {"type": "array", "maxItems": 50, "items": {"type": "string"}},
    "max_page_bytes": {"type": "integer", "minimum": 1024, "maximum": 50000000},
    "max_concurrency": {"type": "integer", "minimum": 1, "maximum": 16, "default": 1},
    "rate_limit_per_minute": {"type": "integer", "minimum": 1, "maximum": 60000, "default": 60},
    "politeness_delay_ms": {"type": "integer", "minimum": 0, "maximum": 60000, "default": 0},
    "allow_private_networks": {"type": "boolean", "default": false}
  },
  "additionalProperties": false
}
