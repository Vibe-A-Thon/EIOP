{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:eoip:schema:telemetry_evidence:1.0",
  "title": "TelemetryEvidence v1",
  "type": "object",
  "required": ["schema_version", "evidence_id", "source_system", "evidence_type", "window_start", "window_end", "source_ref"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "evidence_id": {"type": "string", "minLength": 1, "maxLength": 512},
    "source_system": {"type": "string", "minLength": 1, "maxLength": 128},
    "source_ref": {"type": "string", "minLength": 1, "maxLength": 4096},
    "evidence_type": {"enum": ["LOG_PATTERN", "ERROR_SIGNATURE", "METRIC_WINDOW", "TRACE_EXEMPLAR", "DASHBOARD", "MONITOR", "SLO"]},
    "service_id": {"type": ["string", "null"], "maxLength": 2048},
    "window_start": {"type": "string", "format": "date-time"},
    "window_end": {"type": "string", "format": "date-time"},
    "fingerprint": {"type": ["string", "null"], "maxLength": 256},
    "summary": {"type": ["string", "null"], "maxLength": 8192},
    "sample_count": {"type": "integer", "minimum": 0},
    "bounded_exemplars": {"type": "array", "maxItems": 100, "items": {"type": "string", "maxLength": 512}},
    "metadata": {"type": "object"}
  },
  "additionalProperties": false
}
