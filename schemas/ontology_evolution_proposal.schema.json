{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:eoip:schema:ontology_evolution_proposal:1.0",
  "title": "OntologyEvolutionProposal v1",
  "type": "object",
  "required": ["schema_version", "proposal_id", "proposal_type", "status", "evidence_count", "created_at"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "proposal_id": {"type": "string", "minLength": 1, "maxLength": 512},
    "proposal_type": {"enum": ["ENTITY_TYPE", "RELATIONSHIP_TYPE", "PROPERTY", "CONSTRAINT", "MAPPING"]},
    "status": {"enum": ["PROPOSED", "APPROVED", "REJECTED", "SUPERSEDED"]},
    "candidate_name": {"type": ["string", "null"], "maxLength": 256},
    "candidate_parent": {"type": ["string", "null"], "maxLength": 256},
    "constraints": {"type": "array", "items": {"type": "string", "maxLength": 2048}},
    "examples": {"type": "array", "items": {"type": "object"}},
    "evidence_count": {"type": "integer", "minimum": 0},
    "impact_analysis": {"type": "object"},
    "migration_required": {"type": "boolean"},
    "created_at": {"type": "string", "format": "date-time"},
    "reviewed_at": {"type": ["string", "null"], "format": "date-time"}
  },
  "additionalProperties": false
}
