{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:eoip:schema:ontology_induction_result:1.0",
  "title": "OntologyInductionResult v1",
  "description": "Result of LLM-assisted ontology schema induction from text corpus (KGR-G-015). Includes induced types/relations, SHACL validation results, and consolidation guard outcomes.",
  "type": "object",
  "required": ["schema_version", "induction_id", "corpus_stats", "induced_types", "induced_relations", "shacl_validation", "created_at"],
  "properties": {
    "schema_version": { "const": "1.0" },
    "induction_id": { "type": "string", "minLength": 1 },
    "corpus_stats": {
      "type": "object",
      "required": ["documents_processed", "total_tokens"],
      "properties": {
        "documents_processed": { "type": "integer", "minimum": 0 },
        "total_tokens": { "type": "integer", "minimum": 0 },
        "languages_detected": { "type": "array", "items": { "type": "string" } },
        "domains_detected": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": false
    },
    "induced_types": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["type_name", "evidence_count", "confidence", "status"],
        "properties": {
          "type_name": { "type": "string", "pattern": "^[A-Z][a-zA-Z0-9_]*$" },
          "parent_type": { "type": ["string", "null"] },
          "description": { "type": "string" },
          "evidence_count": { "type": "integer", "minimum": 1 },
          "confidence": { "type": "number", "minimum": 0.0, "maximum": 1.0 },
          "status": { "type": "string", "enum": ["PROPOSED", "CONSOLIDATED", "REJECTED_DUPLICATE", "REJECTED_DRIFT"] },
          "consolidated_into": { "type": ["string", "null"], "description": "Target type name if this was merged into an existing type." },
          "sample_entities": { "type": "array", "items": { "type": "string" }, "maxItems": 5 },
          "properties": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["name", "data_type"],
              "properties": {
                "name": { "type": "string" },
                "data_type": { "type": "string", "enum": ["string", "integer", "float", "boolean", "datetime", "uri", "json"] },
                "required": { "type": "boolean", "default": false },
                "description": { "type": "string" }
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      },
      "description": "Entity types induced from the corpus."
    },
    "induced_relations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["relation_name", "from_type", "to_type", "evidence_count", "confidence"],
        "properties": {
          "relation_name": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]*$" },
          "from_type": { "type": "string" },
          "to_type": { "type": "string" },
          "cardinality": { "type": "string", "enum": ["ONE_TO_ONE", "ONE_TO_MANY", "MANY_TO_MANY"] },
          "evidence_count": { "type": "integer", "minimum": 1 },
          "confidence": { "type": "number", "minimum": 0.0, "maximum": 1.0 },
          "sample_triples": { "type": "array", "items": { "type": "array", "items": { "type": "string" }, "minItems": 3, "maxItems": 3 }, "maxItems": 3 }
        },
        "additionalProperties": false
      }
    },
    "shacl_validation": {
      "type": "object",
      "required": ["shapes_evaluated", "conformant", "violations"],
      "properties": {
        "shapes_evaluated": { "type": "integer", "minimum": 0 },
        "conformant": { "type": "boolean" },
        "violations": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["shape_id", "focus_node", "severity", "message"],
            "properties": {
              "shape_id": { "type": "string" },
              "focus_node": { "type": "string" },
              "severity": { "type": "string", "enum": ["INFO", "WARNING", "VIOLATION"] },
              "message": { "type": "string" },
              "path": { "type": ["string", "null"] }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false,
      "description": "SHACL anti-drift guard validation results."
    },
    "consolidation_guard": {
      "type": "object",
      "properties": {
        "duplicates_detected": { "type": "integer", "minimum": 0 },
        "types_merged": { "type": "integer", "minimum": 0 },
        "drift_violations": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": false
    },
    "llm_provider": {
      "type": ["string", "null"],
      "description": "LLM backend used for induction (e.g. ollama/llama3, local/phi-3)."
    },
    "duration_ms": { "type": "number", "minimum": 0 },
    "created_at": { "type": "string", "format": "date-time" },
    "metadata": { "type": "object", "default": {} }
  },
  "additionalProperties": false
}
