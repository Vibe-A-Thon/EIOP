{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:eoip:schema:normalized_relationship:1.0",
  "title": "NormalizedRelationship v1",
  "type": "object",
  "required": ["schema_version", "relationship_id", "relationship_type", "from_id", "to_id", "evidence_refs", "creation_status"],
  "properties": {
    "schema_version": { "const": "1.0" },
    "relationship_id": { "type": "string", "minLength": 1 },
    "relationship_type": { "type": "string", "minLength": 1 },
    "from_id": { "type": "string", "minLength": 1 },
    "to_id": { "type": "string", "minLength": 1 },
    "evidence_refs": { "type": "array", "items": { "type": "string" } },
    "creation_status": { "type": "string", "enum": ["DETERMINISTIC", "INFERRED", "HUMAN_CONFIRMED"] },
    "confidence": { "type": ["number", "null"], "minimum": 0.0, "maximum": 1.0 },
    "properties": { "type": ["object", "null"] }
  },
  "additionalProperties": false
}
