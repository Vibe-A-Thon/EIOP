{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:eoip:schema:source_registry_entry:1.0",
  "title": "SourceRegistryEntry v1",
  "type": "object",
  "required": ["schema_version", "source_id", "source_type", "name", "enabled", "capabilities", "config", "secret_refs", "created_at", "updated_at"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "source_id": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"},
    "source_type": {"enum": ["api_portal", "confluence", "datadog", "documents", "figma", "fortuna", "github", "gitlab", "grafana", "jira", "kibana", "local_files", "qtest", "rally", "servicenow", "web"]},
    "name": {"type": "string", "minLength": 1, "maxLength": 256},
    "base_url": {"type": ["string", "null"], "maxLength": 2048},
    "acquisition_modes": {"type": "array", "maxItems": 16, "items": {"enum": ["baseline", "poll", "webhook", "reconcile", "replay"]}},
    "allowed_scopes": {"type": "array", "maxItems": 1000, "items": {"type": "string"}},
    "excluded_scopes": {"type": "array", "maxItems": 1000, "items": {"type": "string"}},
    "polling_frequency_seconds": {"type": ["integer", "null"], "minimum": 1, "maximum": 31536000},
    "webhook_status": {"enum": ["UNCONFIGURED", "CONFIGURED", "ACTIVE", "DISABLED", "FAILING"]},
    "mapping_version": {"type": ["string", "null"], "maxLength": 128},
    "parser_version": {"type": ["string", "null"], "maxLength": 128},
    "checkpoint": {"type": ["string", "null"], "maxLength": 4096},
    "last_successful_baseline": {"type": ["string", "null"], "maxLength": 64},
    "last_incremental_run": {"type": ["string", "null"], "maxLength": 64},
    "reconciliation_schedule": {"type": ["string", "null"], "maxLength": 256},
    "health": {"enum": ["UNKNOWN", "HEALTHY", "DEGRADED", "UNAVAILABLE", "MISCONFIGURED"]},
    "freshness_slo_seconds": {"type": ["integer", "null"], "minimum": 1, "maximum": 31536000},
    "compatibility": {"type": "object"},
    "enabled": {"type": "boolean"},
    "capabilities": {"$ref": "source_capabilities.schema.json"},
    "config": {"type": "object"},
    "secret_refs": {"type": "object", "additionalProperties": {"type": "string", "pattern": "^(env|file|vault)://"}},
    "created_at": {"type": "string", "format": "date-time"},
    "updated_at": {"type": "string", "format": "date-time"}
  },
  "additionalProperties": false
}
