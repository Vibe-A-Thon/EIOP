{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:eoip:schema:incremental_index_event:1.0",
  "title": "IncrementalIndexEvent v1",
  "description": "Event emitted by the incremental AST indexer (KGR-G-012) when file changes are detected via git hooks. Captures diff-only re-indexing with symbol impact propagation.",
  "type": "object",
  "required": ["schema_version", "event_id", "commit_sha", "trigger", "files_changed", "symbols_updated", "created_at"],
  "properties": {
    "schema_version": { "const": "1.0" },
    "event_id": { "type": "string", "minLength": 1 },
    "commit_sha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$",
      "description": "Git commit that triggered the re-index."
    },
    "trigger": {
      "type": "string",
      "enum": ["PRE_COMMIT", "POST_COMMIT", "POST_MERGE", "MANUAL", "WATCH"],
      "description": "What initiated the incremental index run."
    },
    "files_changed": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["path", "change_type"],
        "properties": {
          "path": { "type": "string", "description": "Repository-relative file path." },
          "change_type": { "type": "string", "enum": ["ADDED", "MODIFIED", "DELETED", "RENAMED"] },
          "old_path": { "type": ["string", "null"], "description": "Previous path if renamed." },
          "content_hash": { "type": ["string", "null"], "description": "SHA-256 of the new file content." }
        },
        "additionalProperties": false
      },
      "description": "Files detected in the diff."
    },
    "symbols_updated": {
      "type": "integer",
      "minimum": 0,
      "description": "Total AST symbols (functions, classes, imports) re-indexed."
    },
    "symbols_removed": {
      "type": "integer",
      "minimum": 0,
      "description": "Symbols tombstoned due to file deletion or refactoring."
    },
    "impact_propagation": {
      "type": "object",
      "properties": {
        "direct_dependents": { "type": "integer", "minimum": 0, "description": "Files directly importing changed symbols." },
        "transitive_dependents": { "type": "integer", "minimum": 0, "description": "Files transitively affected." },
        "propagation_depth": { "type": "integer", "minimum": 0, "description": "Maximum hop depth of impact chain." }
      },
      "additionalProperties": false,
      "description": "Impact analysis across the dependency graph."
    },
    "duration_ms": { "type": "number", "minimum": 0 },
    "created_at": { "type": "string", "format": "date-time" },
    "metadata": { "type": "object", "default": {} }
  },
  "additionalProperties": false
}
