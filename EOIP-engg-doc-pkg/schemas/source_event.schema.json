{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SourceEvent",
  "type": "object",
  "required": [
    "schema_version",
    "event_id",
    "source_system",
    "source_record_id",
    "captured_at",
    "payload_hash",
    "payload"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "event_id": {
      "type": "string"
    },
    "source_system": {
      "type": "string"
    },
    "source_record_id": {
      "type": "string"
    },
    "source_version": {
      "type": [
        "string",
        "null"
      ]
    },
    "captured_at": {
      "type": "string"
    },
    "payload_hash": {
      "type": "string"
    },
    "payload": {
      "type": "object"
    },
    "metadata": {
      "type": "object"
    }
  }
}
