{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ToolResult",
  "type": "object",
  "required": [
    "tool_call_id",
    "status"
  ],
  "properties": {
    "tool_call_id": {
      "type": "string"
    },
    "status": {
      "enum": [
        "SUCCEEDED",
        "FAILED",
        "DENIED",
        "TIMEOUT"
      ]
    },
    "result": {},
    "evidence_refs": {
      "type": "array"
    },
    "error": {
      "type": [
        "object",
        "null"
      ]
    }
  }
}
