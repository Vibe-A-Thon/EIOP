{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AgentRequest",
  "type": "object",
  "required": [
    "request_id",
    "agent_id",
    "goal"
  ],
  "properties": {
    "schema_version": {
      "const": "2.0",
      "default": "2.0"
    },
    "request_id": {
      "type": "string"
    },
    "agent_id": {
      "type": "string"
    },
    "goal": {
      "type": "string"
    },
    "context_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "budgets": {
      "type": "object"
    },
    "actor_id": {
      "type": "string"
    },
    "correlation_id": {
      "type": ["string", "null"]
    },
    "parent_run_id": {
      "type": ["string", "null"]
    },
    "recursion_depth": {
      "type": "integer",
      "minimum": 0
    },
    "dry_run": {
      "type": "boolean"
    },
    "metadata": {
      "type": "object"
    }
  }
}
