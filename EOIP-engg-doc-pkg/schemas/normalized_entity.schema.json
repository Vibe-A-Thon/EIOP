{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "NormalizedEntity",
  "type": "object",
  "required": [
    "schema_version",
    "canonical_id",
    "entity_type",
    "graph_domain",
    "source_refs",
    "properties"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "canonical_id": {
      "type": "string"
    },
    "entity_type": {
      "type": "string"
    },
    "graph_domain": {
      "type": "string"
    },
    "source_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "creation_status": {
      "enum": [
        "DETERMINISTIC",
        "INFERRED",
        "HUMAN_CONFIRMED"
      ]
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "properties": {
      "type": "object"
    }
  }
}
