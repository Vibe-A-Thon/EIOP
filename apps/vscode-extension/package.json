{
  "name": "eoip-context",
  "displayName": "EOIP Context",
  "description": "Read-only search, code context, trace paths and impact from a local EOIP deployment.",
  "version": "0.1.0",
  "publisher": "eoip-local",
  "license": "UNLICENSED",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./extension.js",
  "contributes": {
    "commands": [
      {
        "command": "eoip.setToken",
        "title": "EOIP: Set Access Token"
      },
      {
        "command": "eoip.search",
        "title": "EOIP: Search Knowledge Graph"
      },
      {
        "command": "eoip.context",
        "title": "EOIP: Context for Active File"
      },
      {
        "command": "eoip.impact",
        "title": "EOIP: Explore Impact"
      },
      {
        "command": "eoip.path",
        "title": "EOIP: Trace Requirement to Code"
      },
      {
        "command": "eoip.lineage",
        "title": "EOIP: Trace Provenance / Lineage"
      },
      {
        "command": "eoip.retrieval",
        "title": "EOIP: GraphRAG Retrieval"
      },
      {
        "command": "eoip.openSource",
        "title": "EOIP: Open Symbol Source"
      }
    ],
    "views": {
      "explorer": [
        {
          "id": "eoip.contextView",
          "name": "EOIP Context"
        }
      ]
    },
    "configuration": {
      "title": "EOIP",
      "properties": {
        "eoip.apiUrl": {
          "type": "string",
          "default": "http://localhost:8000",
          "description": "URL of your local EOIP API."
        },
        "eoip.repositoryRoot": {
          "type": "string",
          "default": "",
          "description": "Local root matching the ingested repository (for example eoip/demo/demodata/core/demo-repo)."
        }
      }
    }
  },
  "scripts": {
    "package": "vsce package --allow-missing-repository --out /output/eoip-context-0.1.0.vsix",
    "test": "node ./test/runTest.js"
  },
  "devDependencies": {
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "3.6.0"
  }
}
