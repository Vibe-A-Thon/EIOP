    "message_queues": [
      {"type": "kafka", "broker": "kafka-broker.mfs.internal:9092", "topics": ["mfs.payment.events", "mfs.payment.settlements", "mfs.payment.dlq"]},
      {"type": "kafka", "broker": "kafka-broker.mfs.internal:9092", "consumer_groups": ["mfs-webhook-dispatch", "mfs-analytics-agg", "mfs-settlement-proc"]}
    ],
    "pods": [
      {"name": "mfs-pay-pod-01", "namespace": "mfs-payments", "replicas": 4, "resources": {"cpu": "2", "memory": "4Gi"}, "services": ["payment-processing", "tokenization", "webhook-dispatch"]},
