            "type": {"name": "Causes", "outward": "caused"},
            "outwardIssue": {"key": "INC-080101", "fields": {"summary": "INC0080101: Connection pool exhaustion in payment gateway"}}
          }
        ],
        "created": "2026-09-28T14:00:00.000+0000",
        "updated": "2026-10-03T16:00:00.000+0000",
        "resolutiondate": null
