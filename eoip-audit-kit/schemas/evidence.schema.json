{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://eoip-audit-kit.local/schemas/evidence.schema.json",
  "title": "EOIP Audit Evidence Bundle",
  "description": "Proof policy 1.1.0: L1 never closes Partial/Implemented. Partial needs L2+residual_gaps. Implemented needs L2+(L3 same commit|L4). Critical needs L5 dual-control. Stale if commit mismatch.",
  "type": "object",
  "required": [
    "schema_version",
    "proof_policy_version",
    "project",
    "git_commit",
    "generated_at",
    "generated_by",
    "evidence_items"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.1.0",
      "description": "Structural schema version."
    },
    "proof_policy_version": {
      "type": "string",
      "const": "1.1.0",
      "description": "Closure rules version. Must be 1.1.0."
    },
    "project": {
      "type": "string",
      "minLength": 1
    },
    "git_commit": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{7,40}$"
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "generated_by": {
      "type": "object",
      "required": [
        "agent_id",
        "role"
      ],
      "additionalProperties": false,
      "properties": {
        "agent_id": {
          "type": "string",
          "minLength": 1
        },
        "role": {
          "type": "string",
          "minLength": 1
        },
        "prompt_hash": {
          "type": "string"
        }
      }
    },
    "baseline_commit": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{7,40}$"
    },
    "notes": {
      "type": "string"
    },
    "evidence_items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/definitions/EvidenceItem"
      }
    }
  },
  "definitions": {
    "EvidenceItem": {
      "type": "object",
      "required": [
        "requirement_id",
        "evidence_id",
        "proof_tier",
        "type",
        "summary",
        "confidence",
        "redaction_status"
      ],
      "additionalProperties": false,
      "properties": {
        "requirement_id": {
          "type": "string",
          "pattern": "^REQ-[A-Z]+-[0-9]{4}$"
        },
        "evidence_id": {
          "type": "string",
          "pattern": "^EVI-[0-9A-Za-z_-]+$"
        },
        "proof_tier": {
          "type": "string",
          "enum": [
            "L1",
            "L2",
            "L3",
            "L4",
            "L5"
          ],
          "description": "L0 forbidden. L1 never closes Partial/Implemented alone."
        },
        "type": {
          "type": "string",
          "enum": [
            "code_link",
            "test_run",
            "ci_run",
            "runtime_log",
            "metric",
            "screenshot",
            "artifact",
            "negative_proof",
            "independent_review",
            "sbom",
            "scan_report"
          ]
        },
        "summary": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "links": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "kind",
              "url"
            ],
            "additionalProperties": false,
            "properties": {
              "kind": {
                "type": "string",
                "enum": [
                  "code",
                  "test",
                  "ci",
                  "doc",
                  "artifact",
                  "other"
                ]
              },
              "url": {
                "type": "string",
                "minLength": 1
              },
              "label": {
                "type": "string"
              }
            }
          }
        },
        "repro_command": {
          "type": "string"
        },
        "expected_result": {
          "type": "string"
        },
        "actual_result": {
          "type": "string"
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "redaction_status": {
          "type": "string",
          "enum": [
            "clean",
            "redacted",
            "not_applicable"
          ]
        },
        "git_commit": {
          "type": "string",
          "pattern": "^[0-9a-fA-F]{7,40}$",
          "description": "Must match audited commit or item is STALE."
        },
        "ci_job": {
          "type": "string"
        },
        "ci_run_id": {
          "type": "string"
        },
        "reviewer_id": {
          "type": "string",
          "description": "Required for L5; must differ from generated_by.agent_id."
        },
        "notes": {
          "type": "string"
        }
      }
    }
  }
}
